<?xml version="1.0" encoding="utf-8"?>
<!-- 로그인 토큰은 noBackupFilesDir 에 있어 원래 백업되지 않는다. 설정값도 기기별이라 백업하지 않는다 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
